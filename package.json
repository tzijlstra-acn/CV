{
  "name": "thomas-zijlstra-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio and CV for Thomas Zijlstra, CFA",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/generate-cv-pdf.mjs",
    "build:html": "node scripts/build.mjs",
    "build:pdf": "node scripts/generate-cv-pdf.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "verify": "node scripts/verify.mjs",
    "build:all": "npm run build:html && npm run check:copy && npm run build:pdf && npm run verify",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "sharp": "^0.35.3"
  }
}
