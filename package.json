{
  "name": "thomas-zijlstra-portfolio",
  "version": "2.0.0",
  "description": "Evidence-driven portfolio and CV for Thomas Zijlstra, CFA",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config portfolio-app/vite.config.ts",
    "dev:portfolio": "vite --config portfolio-app/vite.config.ts",
    "build": "npm run build:html && npm run build:portfolio",
    "build:portfolio": "npm run qa:data && vite build --config portfolio-app/vite.config.ts && node scripts/check-dist.mjs && node scripts/bundle-report.mjs",
    "build:report": "vite build --config portfolio-app/vite.config.ts --mode report && node scripts/bundle-report.mjs",
    "build:html": "node scripts/build.mjs",
    "build:pdf": "node scripts/generate-cv-pdf.mjs",
    "build:all": "npm run build:html && npm run check:copy && npm run build:pdf && npm run build:portfolio && npm run verify",
    "preview": "vite preview --config portfolio-app/vite.config.ts",
    "serve": "vite preview --config portfolio-app/vite.config.ts",
    "check:copy": "node scripts/check-copy.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "vitest run",
    "test:portfolio": "vitest run",
    "test:e2e": "playwright test",
    "qa:data": "tsx scripts/check-data.ts",
    "qa:content": "tsx scripts/check-portfolio-content.ts",
    "qa:claims": "tsx scripts/check-claims.ts",
    "qa:links": "node scripts/check-links.mjs",
    "qa:visual": "tsx scripts/capture-portfolio.mjs",
    "qa:lighthouse": "node scripts/lighthouse.mjs",
    "import:nfr-network": "node scripts/import-nfr-network.mjs",
    "social:card": "node scripts/render-social-card.mjs",
    "release": "node scripts/package-release.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "qa:hash-terms": "tsx scripts/hash-confidential-terms.ts",
    "qa:confidential": "tsx scripts/scan-confidential.ts",
    "qa:release-gate": "tsx scripts/check-data.ts --release",
    "qa:rebaseline-cv": "node scripts/rebaseline-cv.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-router": "1.170.46",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "rollup-plugin-visualizer": "7.1.1",
    "sharp": "^0.35.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
