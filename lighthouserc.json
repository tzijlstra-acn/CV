{
  "ci": {
    "collect": {
      "startServerCommand": "node node_modules/vite/bin/vite.js preview --config portfolio-app/vite.config.ts --port 4182 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4182/CV/",
        "http://localhost:4182/CV/case/nfr-work-fabric/",
        "http://localhost:4182/CV/case/ai-economics/",
        "http://localhost:4182/CV/evidence/",
        "http://localhost:4182/CV/capabilities/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:seo": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./qa/lighthouse"
    }
  }
}
