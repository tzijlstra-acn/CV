  "event": {
    "title": "Synthetic third-party cyber incident",
    "summary": "A payment-services vendor reports a cyber incident. One work object carries the case across process boundaries, along links that exist in the source dataset.",
    "steps": [
      {
        "process": "tprm",
        "action": "The vendor notification opens a third-party case."
      },
      {
        "process": "isrisk",
        "link": "isrisk-to-tprm",
        "action": "The security assessment attaches to the same case."
      },
      {
        "process": "bcm",
        "link": "tprm-to-bcm",
        "action": "Continuity plans for the affected services are reviewed."
      },
      {
        "process": "orm",
        "link": "tprm-to-orm",
        "action": "An operational-risk event is recorded with its evidence."
      },
      {
        "process": "rcsa",
        "link": "orm-to-rcsa",
        "action": "A control re-assessment is queued for the next cycle."
      }
    ]
  },
  "cascade": [
    {
      "id": "problem",
      "label": "Business problem",
      "detail": "Capable systems, fragmented work: context, evidence and ownership break at every handover."
    },
    {
      "id": "value-thesis",
      "label": "Value thesis",
      "detail": "Six value lenses, from professional capacity to management transparency. No numbers before a baseline."
    },
    {
      "id": "process-model",
      "label": "Process model",
      "detail": "Eight process families treated as one network, imported from a reference dataset at a pinned commit."
    },
    {
      "id": "contract",
      "label": "Work-object contract",
      "detail": "Every process module declares trigger, stages, roles, evidence, tasks, controls, measures and version."
    },
    {
      "id": "role-views",
      "label": "Role views",
      "detail": "One work object, with a permissioned view and action set for each role."
    },
    {
      "id": "shared-services",
      "label": "Shared services",
      "detail": "Flow Engine, routing, evidence and semantics, integration and observability, built once and reused."
    },
    {
      "id": "controls",
      "label": "Controls",
      "detail": "Contextual identity, bound approval, controlled write-back and an audit receipt for every action."
    },
    {
      "id": "roadmap",
      "label": "Roadmap",
      "detail": "Understand first, start with one process cluster, then grow by cluster on evidence."
    },
    {
      "id": "operating-model",
      "label": "Operating model",
      "detail": "A shared platform team, federated process owners, enterprise control partners and independent oversight."
    }
  ],
