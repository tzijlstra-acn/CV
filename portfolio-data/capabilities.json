  "patterns": [
    {
      "id": "provider-abstracted-routing",
      "label": "Provider-abstracted model routing",
      "description": "Tasks are routed to different models behind one provider interface, so the model choice can change without rewriting the workflow."
    },
    {
      "id": "state-machine-approvals",
      "label": "State machine with approval gates",
      "description": "Every workflow transition is explicit, and consequential transitions wait for a named human decision."
    },
    {
      "id": "append-only-audit",
      "label": "Append-only audit record",
      "description": "Actions and decisions are written to a record that is added to, never edited."
    },
    {
      "id": "evidence-package",
      "label": "Traceable evidence package",
      "description": "Outputs carry links back to the inputs and decisions that produced them."
    },
    {
      "id": "knowledge-graph-context",
      "label": "Knowledge graph as shared context",
      "description": "Controls, policies and obligations are related in a graph that several workflows read."
    },
    {
      "id": "policy-verification",
      "label": "Policy verification before write-back",
      "description": "Proposed changes are checked against rules before anything reaches a system of record."
    },
    {
      "id": "scenario-cost-model",
      "label": "Scenario-based cost model",
      "description": "Usage, routing, hosting and overhead assumptions combine into comparable scenarios."
    },
    {
      "id": "infrastructure-as-code-reference",
      "label": "Infrastructure-as-code reference modules",
      "description": "Cloud controls are expressed as reviewable modules, kept separate from the runnable local mode."
    },
    {
      "id": "evaluation-gate",
      "label": "Evaluation suite as a release gate",
      "description": "A workload is released only when its evaluation suite passes defined thresholds."
    },
    {
      "id": "live-state-streaming",
      "label": "Live state streaming",
      "description": "The interface follows backend state changes as they happen, without polling."
    },
    {
      "id": "source-import-validation",
      "label": "Validated source import",
      "description": "External source data is parsed at build time, validated against a schema and pinned to a commit."
    },
    {
      "id": "url-state",
      "label": "Shareable URL state",
      "description": "Selections live in the URL, so every view can be deep-linked and the browser history works."
    },
    {
      "id": "contextual-access",
      "label": "Contextual access and bound approval",
      "description": "What a person can see or do depends on role, case relationship, purpose and action class, and approvals bind to one action."
    },
    {
      "id": "weighted-model-selection",
      "label": "Weighted model selection per task tier",
      "description": "Models are chosen for each task tier by weighted criteria such as reasoning, speed, cost, context, safety and sovereignty, not by vendor."
    },
    {
      "id": "deterministic-engine",
      "label": "Deterministic engine, model narrates",
      "description": "Figures come from a deterministic calculation engine and are hashed; the model explains them but never produces them."
    },
    {
      "id": "policy-gated-tools",
      "label": "Policy-gated tool use",
      "description": "Each workflow stage may only call the tools its policy allows, with a hard deny list for external sends."
    }
  ]
}
